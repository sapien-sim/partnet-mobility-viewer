{
  "name": "partnet-mobility-viewer",
  "private": true,
  "version": "0.1.0",
  "description": "Single-page viewer for the PartNet-Mobility dataset",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --format=iife --target=es2020 --outfile=dist/bundle.js --minify",
    "watch": "esbuild src/main.ts --bundle --format=iife --target=es2020 --outfile=dist/bundle.js --watch --minify",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "babylonjs": "4.2.1",
    "babylonjs-loaders": "4.2.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "~4.4.4"
  },
  "license": "Apache-2.0"
}
